{
  "name": "@supertext-review/extension",
  "version": "0.1.0",
  "description": "Supertext Localization Review: Chrome extension for reviewing a website's translations in context.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "zip": "node build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "node build.mjs --e2e && vitest run test/e2e"
  },
  "dependencies": {
    "@supertext-review/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "postgres": "3.4.9"
  }
}
