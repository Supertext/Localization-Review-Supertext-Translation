# Supertext translation proxy settings (see docs/INSTALLATION.md). On Railway, set these as service variables.

# Postgres server. With REVIEW_DB_NAME, the proxy uses (and creates) its own database on it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
REVIEW_DB_NAME=review

# Shared staff login password, at least 12 characters. Never commit the real one.
REVIEW_ADMIN_PASSWORD=

# Signs review links, at least 32 random characters (e.g. `openssl rand -base64 33`). Changing it invalidates every link.
REVIEW_LINK_SECRET=

# Optional: the proxy's public address, used in review links (default: the address the page was opened with).
# REVIEW_PUBLIC_URL=https://review-proxy.example.com

# Optional: the Supertext API the proxy forwards to (default https://api.supertext.com/v1/).
# Tests point it at the stand-in. Never point it anywhere else in production.
# SUPERTEXT_API_URL=https://api.supertext.com/v1/

# Optional: time zone for dates in the UI (default Europe/Zurich).
# REVIEW_TIMEZONE=Europe/Zurich
