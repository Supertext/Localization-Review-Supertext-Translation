{
  "name": "@supertext-review/proxy",
  "version": "0.1.0",
  "description": "Supertext translation proxy: speaks the Supertext AI file translation API v1, keeps every translation and serves reviewers' corrections.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "docs:screenshots": "node scripts/docs-screenshots.mjs"
  },
  "dependencies": {
    "@supertext-review/shared": "0.1.0",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
